# Generate a random salt and store its base64 value in ADMIN_PASSWORD_SALT.
# ADMIN_PASSWORD_HASH is the base64 PBKDF2-SHA256 result for the chosen password,
# using 100000 iterations, the configured salt, and a 32-byte output.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# A separate random base64 value with at least 32 bytes, used to sign sessions.
ADMIN_SESSION_SECRET=

# Optional on Vercel. Defaults to the deployed Sites backend that owns D1/R2.
PORTFOLIO_API_ORIGIN=

# Secret used only by the Vercel function to reach a Sign in with ChatGPT-protected Sites backend.
SITES_BYPASS_TOKEN=
